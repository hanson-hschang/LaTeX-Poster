%%----------------------------------------------------------------------------------------
%%   PROCESS OPTIONAL ARGUMENTS
%%----------------------------------------------------------------------------------------

% 1. Define the length register
\newlength{\headerHeight}
\newlength{\paddingWidth}
\newlength{\blockTitleHeight}
\newlength{\sidePadding}

% 2. Define the "key" that the user can pass
\DeclareOptionBeamer{headerHeight}{\setlength{\headerHeight}{#1}}
\DeclareOptionBeamer{paddingWidth}{\setlength{\paddingWidth}{#1}}
\DeclareOptionBeamer{blockTitleHeight}{\setlength{\blockTitleHeight}{#1}}
\DeclareOptionBeamer{sidePadding}{\setlength{\sidePadding}{#1}}
% 3. Set a default value (in case the user doesn't provide the argument)
\ExecuteOptionsBeamer{headerHeight=10cm}
\ExecuteOptionsBeamer{paddingWidth=2em}
\ExecuteOptionsBeamer{blockTitleHeight=6\baselineskip}
\ExecuteOptionsBeamer{sidePadding=3.2em}

% 4. Process the options provided in \usetheme[...]
\ProcessOptionsBeamer


%%----------------------------------------------------------------------------------------
%%   BEAMER POSTER STYLE
%%----------------------------------------------------------------------------------------


\newcommand{\paragraph}[1]{\medskip\noindent{\bf #1}\hspace{1em}}



\setlength{\heavyrulewidth}{3pt} % Default is 0.08em
\setlength{\lightrulewidth}{1.5pt} % Default is 0.05em
\setlength{\cmidrulewidth}{1.5pt}  % Default is 0.03em


% \setbeamerfont{block title}{family=\Raleway,size=\large,series=\bfseries}
% \setbeamerfont{heading}{family=\Lato,series=\bfseries}
\setbeamerfont{caption}{size=\small, family=\sffamily}
% \setbeamerfont{footline}{family=\Raleway,size=\normalsize}

\setbeamerfont{heading}{series=\bfseries, family=\sffamily}

% Heading
\newcommand\heading[1]
{%
  \par\bigskip
  {\usebeamerfont{heading}\usebeamercolor[fg]{heading}#1}\par\smallskip
}

%%----------------------------------------------------------------------------------------
%%   Headline Template
%%----------------------------------------------------------------------------------------

% \setbeamerfont{headline}{family=\Raleway}
\setbeamerfont{headline title}{size=\huge, family=\sffamily, series=\bfseries}
% \setbeamerfont{headline title}{size=\huge,series=\bfseries}
\setbeamerfont{headline author}{size=\large, family=\sffamily}
\setbeamerfont{headline institute}{size=\large, family=\sffamily}



% 1. Stop Beamer from auto-placing the logo in the bottom right (right sidebar)
\setbeamertemplate{sidebar right}{}

% 2. Remove the navigation symbols (the icons in the bottom right)
\beamertemplatenavigationsymbolsempty

\newlength{\logoWidth}
\setlength{\logoWidth}{0cm}

\renewcommand{\logo}[1]{
  % 1. Define a temporary box to hold the resized logo
  \newsavebox{\tempLogoBox}
  
  % 2. Perform the resize inside the box (this happens in memory)
  \sbox{\tempLogoBox}{\resizebox{!}{\dimexpr \headerHeight \relax}{#1}}
  
  % 3. Extract the width from the box
  \setlength{\logoWidth}{\wd\tempLogoBox}
}

\newlength{\qrCodeWidth}
\setlength{\qrCodeWidth}{0cm}

\newcommand{\qrcode}[1]{
  % Similar to the logo, we define a temporary box for theresized QR code and extract its width
  \newsavebox{\tempQRCodeBox}
  \sbox{\tempQRCodeBox}{\resizebox{!}{\dimexpr \headerHeight \relax}{#1}}
  \setlength{\qrCodeWidth}{\wd\tempQRCodeBox}
}


% 3. Updated Headline Template
\setbeamertemplate{headline}{

  \begin{beamercolorbox}{headline}
    \vspace{\paddingWidth}

    \begin{columns}[c,totalwidth=\paperwidth]

      \begin{column}{\paddingWidth+\sidePadding}
        \hspace*{\paddingWidth+\sidePadding}
      \end{column}
      
      % --- Column 1: Logo (Only created if \logo was called) ---
      \ifdim\logoWidth>0pt\relax
        \begin{column}{\logoWidth}
          \usebox{\tempLogoBox}
        \end{column}
      \fi

      % --- Column 2: Title/Author/Institute (Dynamic Width) ---
      \begin{column}{\dimexpr \paperwidth - \logoWidth - \qrCodeWidth - 2\paddingWidth - 2\sidePadding \relax}
        \centering
        % \raggedleft % This pushes the text to the right edge of this column
        % \rightskip=2\paddingWidth  % <--- This adds the \paddingWidth padding on the right
        \ifx\inserttitle\empty\else
          {\usebeamerfont{headline title}\usebeamercolor[fg]{headline title}\inserttitle\\[0.7ex]}
        \fi
        \ifx\beamer@shortauthor\empty\else
          {\usebeamerfont{headline author}\usebeamercolor[fg]{headline author}\insertauthor\\[0.5ex]}
        \fi
        \ifx\insertinstitute\empty\else
          {\usebeamerfont{headline institute}\usebeamercolor[fg]{headline institute}\insertinstitute\\[0ex]}
        \fi
      \end{column}

      % --- Column 3: QR Code (Only created if \qrcode was called) ---
      \ifdim\qrCodeWidth>0pt\relax
        \begin{column}{\qrCodeWidth}
          \usebox{\tempQRCodeBox}
        \end{column}
      \fi

      \begin{column}{\paddingWidth+\sidePadding}
        \hspace*{\paddingWidth+\sidePadding}
      \end{column}

    \end{columns}

    \vspace{\paddingWidth}

  \end{beamercolorbox}
}

%%----------------------------------------------------------------------------------------
%%   Block Template
%%----------------------------------------------------------------------------------------

\newlength{\paddingLength}
\setlength{\paddingLength}{\baselineskip}

\setbeamerfont{block title}{size=\Large}% ,series=\bfseries}
\setbeamerfont{block body}{family=\sffamily}

% --- Block Begin ---
\setbeamertemplate{block begin}{

  % Title
  \vspace{0.25\baselineskip} % Space between blocks
  \begin{beamercolorbox}[wd=\linewidth]{block title}
    \begin{minipage}[c][\blockTitleHeight][c]{\linewidth}
      \hspace*{\paddingLength}
      {\usebeamerfont{block title}\insertblocktitle}
    \end{minipage}
  \end{beamercolorbox}
  
  % Body
  \begin{beamercolorbox}[wd=\linewidth]{block body}
    \centering % This centers the minipage, creating the left/right padding
    \begin{minipage}{\dimexpr\linewidth-2\paddingLength\relax}
      \vspace*{0.25\baselineskip} % Top padding inside the body
      \usebeamerfont{block body}%
      \justifying
}

% --- Block End ---
\setbeamertemplate{block end}{
    \end{minipage}
  \end{beamercolorbox}
  \vspace{0.25\baselineskip} % Space between blocks
}

%%-----------------------------------------------------------------------------------
%%   Footer Template
%%-----------------------------------------------------------------------------------

\setbeamerfont{footline}{size=\large, family=\sffamily}

\newcommand{\footercontent}[1]{\newcommand{\insertfootercontent}{#1}}

\setbeamertemplate{footline}{
  \ifdefined\insertfootercontent
    \begin{beamercolorbox}[vmode]{footline}
      
      \vspace*{\paddingWidth}
      
      \hspace*{\paddingWidth+\sidePadding}
      \usebeamerfont{footline}%
      \centering
      \insertfootercontent
      \hspace*{\paddingWidth+\sidePadding}

      \vspace*{\paddingWidth}
    \end{beamercolorbox}
  \else\fi
}


%%-----------------------------------------------------------------------------------
%%   Environments Template
%%-----------------------------------------------------------------------------------
\newlength{\namelistlabelwd}
\newlength{\namelistbulletwd}

\newcommand{\namelistbullet}{%
  {\usebeamercolor[fg]{itemize item}\usebeamertemplate{itemize item}}%
}

\newenvironment{namelist}[1]{%
  \setlength{\namelistlabelwd}{\widthof{\textit{#1}}}%
  \setlength{\namelistbulletwd}{\widthof{\namelistbullet~}}%
  \begin{list}{}{%
    \setlength{\leftmargin}{\namelistbulletwd}%
    \addtolength{\leftmargin}{\namelistlabelwd}%
    \addtolength{\leftmargin}{1em}%  \labelsep
    \setlength{\labelwidth}{\namelistbulletwd}%
    \addtolength{\labelwidth}{\namelistlabelwd}%
    \setlength{\labelsep}{0.5em}%
    % \setlength{\itemindent}{.5em}%
    \setlength{\topsep}{3pt plus 2pt minus 2.5pt}%
    \setlength{\parsep}{0pt}%
    \setlength{\itemsep}{3pt plus 2pt minus 3pt}%
    \renewcommand{\makelabel}[1]{%
      \namelistbullet~\makebox[\namelistlabelwd][l]{\textit{##1}}\hss%
    }%
  }%
}{%
  \end{list}%
}

